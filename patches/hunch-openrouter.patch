diff --git i/packages/core/src/openrouter.ts w/packages/core/src/openrouter.ts
new file mode 100644
index 0000000..031025f
--- /dev/null
+++ w/packages/core/src/openrouter.ts
@@ -0,0 +1,20 @@
+import { readFileSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+export function openRouterKey(): string | undefined {
+  if (process.env.OPENROUTER_API_KEY?.trim()) return process.env.OPENROUTER_API_KEY.trim();
+  if (!process.env.HOME) return undefined;
+  try {
+    const path = join(homedir(), ".config/siftr/.env");
+    if ((statSync(path).mode & 0o077) !== 0) return undefined;
+    const line = readFileSync(path, "utf8").split("\n").find(s => /^(?:export\s+)?OPENROUTER_API_KEY=/.test(s.trim()));
+    return line?.trim().replace(/^(?:export\s+)?OPENROUTER_API_KEY=/, "").trim().replace(/^["']|["']$/g, "") || undefined;
+  } catch { return undefined; }
+}
+export const openRouterFetch: typeof fetch = async (input, init) => {
+  const url = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url);
+  if (url.href !== "https://openrouter.ai/v1/systemone") throw new Error("OpenRouter decision transport refuses an unexpected destination");
+  const body = JSON.parse(String(init?.body));
+  if (!body.model || String(body.model).startsWith("jev-")) body.model = "typesafe/jev-1.13";
+  return fetch("https://openrouter.ai/api/alpha/decisions", {...init, body: JSON.stringify(body)});
+};
