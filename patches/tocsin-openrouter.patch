+
+fn shared_openrouter_key() -> Option<String> {
+    let path = std::path::PathBuf::from(std::env::var("HOME").ok()?).join(".config/siftr/.env");
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if std::fs::metadata(&path).ok()?.permissions().mode() & 0o077 != 0 { return None; }
+    }
+    for line in std::fs::read_to_string(path).ok()?.lines() {
+        let line = line.trim().strip_prefix("export ").unwrap_or(line.trim());
+        if let Some(value) = line.strip_prefix("OPENROUTER_API_KEY=") {
+            return Some(value.trim().trim_matches(|c| c == '\'' || c == '"').to_string());
+        }
+    }
+    None
+}
