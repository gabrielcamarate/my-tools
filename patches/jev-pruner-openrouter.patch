diff --git i/tests/openrouter-provider.test.ts w/tests/openrouter-provider.test.ts
new file mode 100644
index 0000000..b5bd27e
--- /dev/null
+++ w/tests/openrouter-provider.test.ts
@@ -0,0 +1,44 @@
+import { mkdtemp, mkdir, writeFile, rm, chmod } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, expect, it, vi } from 'vitest';
+import { openRouterKey } from '../src/codex/provider.js';
+import { saveContext } from '../src/codex/context.js';
+import { pruneCodexOutput } from '../src/codex/prune.js';
+const homes: string[] = [];
+afterEach(async () => { vi.unstubAllGlobals(); await Promise.all(homes.splice(0).map(h => rm(h, { recursive: true, force: true }))); });
+async function home() { const h = await mkdtemp(join(tmpdir(), 'pruner-provider-')); homes.push(h); return h; }
+it('environment wins, explicit empty disables fallback, absent file fails open', async () => {
+  const h = await home();
+  expect(await openRouterKey({ OPENROUTER_API_KEY: 'synthetic-env' }, h)).toBe('synthetic-env');
+  expect(await openRouterKey({}, h)).toBeUndefined();
+  await mkdir(join(h, '.config/siftr'), { recursive: true });
+  await writeFile(join(h, '.config/siftr/.env'), "OPENROUTER_API_KEY='synthetic-file'\n", { mode: 0o600 });
+  expect(await openRouterKey({}, h)).toBe('synthetic-file');
+  expect(await openRouterKey({ OPENROUTER_API_KEY: '' }, h)).toBeUndefined();
+  await chmod(join(h, '.config/siftr/.env'), 0o644);
+  expect(await openRouterKey({}, h)).toBeUndefined();
+});
+it('sends typed noul requests to OpenRouter and retains an exact archive', async () => {
+  const h = await home(), id = 'provider-fixture', path = join(h, 'rollout.jsonl');
+  await writeFile(path, [
+    { type: 'session_meta', payload: { id } },
+    { type: 'response_item', payload: { type: 'message', role: 'user', content: [{ type: 'input_text', text: 'Keep errors and deployment artifacts.' }] } },
+  ].map(e => JSON.stringify(e)).join('\n'));
+  await saveContext({ hook_event_name: 'PreToolUse', tool_name: 'Bash', session_id: id, transcript_path: path }, h);
+  const output = Buffer.from(('progress cache current '.repeat(12) + '\n').repeat(500));
+  const fetcher = vi.fn(async (url: string, init: RequestInit) => {
+    expect(url).toBe('https://openrouter.ai/api/alpha/decisions');
+    expect(init.method).toBe('POST');
+    expect(init.headers).toMatchObject({ authorization: 'Bearer synthetic' });
+    const body = JSON.parse(init.body as string);
+    expect(body.model).toBe('typesafe/jev-1.13');
+    expect(Object.keys(body).sort()).toEqual(['model', 'questions', 'state']);
+    for (const question of Object.values(body.questions) as { type: string }[]) expect(question.type).toBe('noul');
+    return new Response(JSON.stringify({ answers: Object.fromEntries(Object.keys(body.questions).map(k => [k, { type: 'noul', noul: 0 }])), usage: { input_tokens: 10 } }));
+  });
+  vi.stubGlobal('fetch', fetcher);
+  const displayed = await pruneCodexOutput(output, 'npm test', { cwd: h, home: h, sessionId: id, apiKey: 'synthetic' });
+  expect(fetcher).toHaveBeenCalled();
+  expect(displayed.length).toBeLessThan(output.length);
+});
