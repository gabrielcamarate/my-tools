diff --git i/src/provider.ts w/src/provider.ts
new file mode 100644
index 0000000..248f22e
--- /dev/null
+++ w/src/provider.ts
@@ -0,0 +1,30 @@
+// Provider-only integration; never inspect a project .env.
+import { readFileSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+export function openRouterKey(
+  env: NodeJS.ProcessEnv = process.env,
+  home = homedir(),
+): string | undefined {
+  if (env.OPENROUTER_API_KEY !== undefined) return env.OPENROUTER_API_KEY.trim() || undefined;
+  try {
+    const path = join(home, ".config", "siftr", ".env");
+    const info = statSync(path);
+    if (!info.isFile() || (info.mode & 0o077) !== 0) return undefined;
+    for (const line of readFileSync(path, "utf8").split("\n")) {
+      const match = /^\s*(?:export\s+)?OPENROUTER_API_KEY\s*=\s*(.*?)\s*$/.exec(line);
+      if (!match) continue;
+      const value = match[1]!;
+      if (
+        (value.startsWith('"') && value.endsWith('"')) ||
+        (value.startsWith("'") && value.endsWith("'"))
+      )
+        return value.slice(1, -1) || undefined;
+      return value.split(/\s+#/)[0]!.trim() || undefined;
+    }
+  } catch {
+    /* Missing credential keeps the upstream deterministic gate. */
+  }
+  return undefined;
+}
