diff --git i/test/openrouter-provider.test.ts w/test/openrouter-provider.test.ts
new file mode 100644
index 0000000..d3e2d4b
--- /dev/null
+++ w/test/openrouter-provider.test.ts
@@ -0,0 +1,45 @@
+import { chmodSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { openRouterKey } from "../src/provider.js";
+import { makeJudge, noul } from "../src/jev.js";
+
+describe("OpenRouter transport", () => {
+  it("uses only the shared private credential with explicit environment precedence", () => {
+    const home = mkdtempSync(join(tmpdir(), "canny-provider-"));
+    try {
+      const dir = join(home, ".config/siftr");
+      mkdirSync(dir, { recursive: true });
+      const file = join(dir, ".env");
+      expect(openRouterKey({}, home)).toBeUndefined();
+      writeFileSync(file, 'OPENROUTER_API_KEY="synthetic-private"', { mode: 0o600 });
+      expect(openRouterKey({}, home)).toBe("synthetic-private");
+      expect(openRouterKey({ OPENROUTER_API_KEY: "synthetic-env" }, home)).toBe("synthetic-env");
+      expect(openRouterKey({ OPENROUTER_API_KEY: "" }, home)).toBeUndefined();
+      chmodSync(file, 0o644);
+      expect(openRouterKey({}, home)).toBeUndefined();
+    } finally {
+      rmSync(home, { recursive: true, force: true });
+    }
+  });
+  it("preserves the typed Decisions wire contract and cache", async () => {
+    process.env.OPENROUTER_API_KEY = "synthetic-env";
+    const fetchFn = vi.fn<typeof fetch>(
+      async () => new Response(JSON.stringify({ answers: { q: { noul: 0.97 } } })),
+    );
+    const judge = makeJudge({ log: () => {}, fetchFn });
+    const questions = { q: noul("Does the message claim completion?") };
+    expect(await judge("Done.", questions)).toEqual({ q: 0.97 });
+    expect(await judge("Done.", questions)).toEqual({ q: 0.97 });
+    expect(fetchFn).toHaveBeenCalledTimes(1);
+    const [url, init] = fetchFn.mock.calls[0]!;
+    expect(url).toBe("https://openrouter.ai/api/alpha/decisions");
+    expect(init?.method).toBe("POST");
+    expect(JSON.parse(String(init?.body))).toEqual({
+      state: "Done.",
+      model: "typesafe/jev-1.13",
+      questions,
+    });
+  });
+});
