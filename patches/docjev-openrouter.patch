diff --git i/src/jev_docs/engines/openrouter.py w/src/jev_docs/engines/openrouter.py
new file mode 100644
index 0000000..3a9cf60
--- /dev/null
+++ w/src/jev_docs/engines/openrouter.py
@@ -0,0 +1,31 @@
+import httpx2
+
+class OpenRouterTransport(httpx2.AsyncHTTPTransport):
+    async def handle_async_request(self, request):
+        if str(request.url) != "https://openrouter.ai/v1/systemone":
+            raise ValueError("Unexpected OpenRouter decision destination")
+        request.url = httpx2.URL("https://openrouter.ai/api/alpha/decisions")
+        return await super().handle_async_request(request)
+
+import os
+from pathlib import Path
+import shlex
+
+def openrouter_key():
+    if os.environ.get("OPENROUTER_API_KEY", "").strip():
+        return os.environ["OPENROUTER_API_KEY"].strip()
+    path = Path.home() / ".config/siftr/.env"
+    if not os.environ.get("HOME"):
+        return None
+    try:
+        if path.stat().st_mode & 0o077:
+            return None
+        for line in path.read_text().splitlines():
+            line = line.strip().removeprefix("export ")
+            if line.startswith("OPENROUTER_API_KEY="):
+                values = shlex.split(line.split("=", 1)[1], comments=True)
+                if len(values) == 1:
+                    return values[0]
+    except (OSError, ValueError):
+        pass
+    return None
