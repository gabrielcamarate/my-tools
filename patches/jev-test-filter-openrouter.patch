new file mode 100644
index 0000000..c9e7516
--- /dev/null
+++ b/test/openrouter-provider.test.ts
@@ -0,0 +1,20 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, mkdirSync, writeFileSync, chmodSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { openRouterKey } from "../src/provider.ts";
+
+test("environment precedence, shared private file, empty disable and unsafe file rejection", () => {
+  const home = mkdtempSync(join(tmpdir(), "jev-provider-test-"));
+  try {
+    mkdirSync(join(home, ".config", "siftr"), { recursive: true });
+    const path = join(home, ".config", "siftr", ".env");
+    writeFileSync(path, "OPENROUTER_API_KEY='synthetic-private'\n", { mode: 0o600 });
+    assert.equal(openRouterKey({}, home), "synthetic-private");
+    assert.equal(openRouterKey({ OPENROUTER_API_KEY: "synthetic-env" }, home), "synthetic-env");
+    assert.equal(openRouterKey({ OPENROUTER_API_KEY: "" }, home), undefined);
+    chmodSync(path, 0o644);
+    assert.equal(openRouterKey({}, home), undefined);
+  } finally { rmSync(home, { recursive: true }); }
+});
