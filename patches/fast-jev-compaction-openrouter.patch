+/** The value of OPENROUTER_API_KEY in a dotenv text, or undefined. */
+export function dotenvKey(text: string): string | undefined {
+  for (const line of text.split('\n')) {
+    const match = /^\s*(?:export\s+)?OPENROUTER_API_KEY\s*=\s*(.*?)\s*$/.exec(line);
+    if (!match) continue;
+    const value = match[1] ?? '';
+    if (value.startsWith('"') && value.endsWith('"')) return value.slice(1, -1) || undefined;
+    if (value.startsWith("'") && value.endsWith("'")) return value.slice(1, -1) || undefined;
+    return (value.split(/\s+#/)[0] ?? '').trim() || undefined;
   }
   return undefined;
 }
 
