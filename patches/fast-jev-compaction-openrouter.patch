diff --git i/tests/openrouter-provider.test.ts w/tests/openrouter-provider.test.ts
new file mode 100644
index 0000000..978fe88
--- /dev/null
+++ w/tests/openrouter-provider.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest';
+
+import { dotenvKey, getApiKey, jevAsker, OPENROUTER_DECISIONS_URL, resolveHookConfig } from '../hooks/fast-jev.js';
+
+function host(env: Record<string, string | undefined>, files: Record<string, string> = {}) {
+  return {
+    env: { get: async (name: string) => env[name] },
+    fs: {
+      read: async (path: string) => {
+        if (!(path in files)) throw new Error('ENOENT');
+        return files[path];
+      },
+    },
+  };
+}
+
+describe('OpenRouter provider', () => {
+  it('sends the typed request to the Decisions API', async () => {
+    let url = '';
+    let body: Record<string, unknown> = {};
+    let headers: Record<string, string> = {};
+    const asker = jevAsker(async (target, init) => {
+      url = target;
+      body = JSON.parse(init?.body ?? '{}');
+      headers = init?.headers ?? {};
+      return { status: 200, ok: true, text: '{"answers":{"q":{"noul":0.9}}}' };
+    }, 'synthetic', resolveHookConfig({}).model);
+    const response = await asker.ask({ text: 'state' } as never, { q: { type: 'noul', instructions: 'keep?' } } as never);
+    expect(url).toBe(OPENROUTER_DECISIONS_URL);
+    expect(headers.authorization).toBe('Bearer synthetic');
+    expect(body.model).toBe('typesafe/jev-1.13');
+    expect(Object.keys(body).sort()).toEqual(['model', 'questions', 'state']);
+    expect(response.answers.q).toEqual({ noul: 0.9 });
+  });
+
+  it('reads the key from the option, the variable, then the private Siftr file', async () => {
+    const files = { '/h/.config/siftr/.env': 'OTHER=1\nexport OPENROUTER_API_KEY="from-file"\n' };
+    const config = resolveHookConfig({});
+    expect(await getApiKey(host({ HOME: '/h' }, files), { ...config, apiKey: 'option' })).toBe('option');
+    expect(await getApiKey(host({ HOME: '/h', OPENROUTER_API_KEY: 'from-env' }, files), config)).toBe('from-env');
+    expect(await getApiKey(host({ HOME: '/h' }, files), config)).toBe('from-file');
+    expect(await getApiKey(host({ HOME: '/h', OPENROUTER_API_KEY: '' }, files), config)).toBeUndefined();
+    expect(await getApiKey(host({ HOME: '/h' }), config)).toBeUndefined();
+    expect(dotenvKey("OPENROUTER_API_KEY='x'")).toBe('x');
+    expect(dotenvKey('OPENROUTER_API_KEY=y # c')).toBe('y');
+  });
+});
