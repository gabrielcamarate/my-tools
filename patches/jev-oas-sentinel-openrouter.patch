diff --git i/src/jev_oas_sentinel/openrouter.py w/src/jev_oas_sentinel/openrouter.py
new file mode 100644
index 0000000..b37965d
--- /dev/null
+++ w/src/jev_oas_sentinel/openrouter.py
@@ -0,0 +1,23 @@
+import os
+from pathlib import Path
+import shlex
+
+def openrouter_key(environment=None):
+    environment = os.environ if environment is None else environment
+    if environment.get("OPENROUTER_API_KEY", "").strip():
+        return environment["OPENROUTER_API_KEY"].strip()
+    path = Path(environment.get("HOME", "/nonexistent")) / ".config/siftr/.env"
+    if not environment.get("HOME"):
+        return None
+    try:
+        if path.stat().st_mode & 0o077:
+            return None
+        for line in path.read_text().splitlines():
+            line = line.strip().removeprefix("export ")
+            if line.startswith("OPENROUTER_API_KEY="):
+                values = shlex.split(line.split("=", 1)[1], comments=True)
+                if len(values) == 1:
+                    return values[0]
+    except (OSError, ValueError):
+        pass
+    return None
