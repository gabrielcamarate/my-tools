+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, writeFileSync, chmodSync, rmSync, symlinkSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { JevDecisionEngine } from '../dist/index.js';
+import { openRouterKey } from '../dist/provider.js';
+import { apiResult } from './helpers.mjs';
+const request={state:'synthetic',questions:{pick:{type:'choice',instructions:'Choose',criteria:{a:'A',b:'B'}}}};
+test('OpenRouter changes only endpoint/auth/model and keeps typed state, questions and response validation',async()=>{
+ const saved={...process.env};process.env.OPENROUTER_API_KEY='synthetic-openrouter';delete process.env.JEV_BASE_URL;delete process.env.JEV_MODEL;
+ try {let seen;const engine=new JevDecisionEngine({fetch:async(url,init)=>{seen={url,auth:new Headers(init.headers).get('authorization'),redirect:init.redirect,body:JSON.parse(init.body)};return Response.json(apiResult(request));}});
+ assert.equal((await engine.decide(request)).answers.pick.choice,'a');
+ assert.deepEqual(seen,{url:'https://openrouter.ai/api/alpha/decisions',auth:'Bearer synthetic-openrouter',redirect:'error',body:{...request,model:'typesafe/jev-1.13'}});
+ await assert.rejects(new JevDecisionEngine({fetch:async()=>Response.json(apiResult(request,()=> 'invented'))}).decide(request),{code:'INVALID_DECISION'});
+ }finally{for(const key of Object.keys(process.env)) if(!(key in saved)) delete process.env[key];Object.assign(process.env,saved);}
+});
+test('shared personal credential is private, optional, never read from project, and explicit empty disables fallback',()=>{
+ const saved={...process.env},folder=mkdtempSync(join(tmpdir(),'jev-provider-'));process.env.HOME=folder;delete process.env.OPENROUTER_API_KEY;
+ try{const path=join(folder,'.config/siftr/.env');mkdirSync(join(folder,'.config/siftr'),{recursive:true});writeFileSync(path,'export OPENROUTER_API_KEY="synthetic-shared"\n',{mode:0o600});assert.ok(openRouterKey()==='synthetic-shared','Synthetic HOME credential isolation failed');
+ process.env.OPENROUTER_API_KEY='synthetic-env';assert.equal(openRouterKey(),'synthetic-env');process.env.OPENROUTER_API_KEY='';assert.equal(openRouterKey(),undefined);
+ delete process.env.OPENROUTER_API_KEY;chmodSync(path,0o644);assert.equal(openRouterKey(),undefined);rmSync(path);writeFileSync(join(folder,'outside'),'OPENROUTER_API_KEY=synthetic-outside',{mode:0o600});symlinkSync(join(folder,'outside'),path);assert.equal(openRouterKey(),undefined);
+ }finally{for(const key of Object.keys(process.env)) if(!(key in saved)) delete process.env[key];Object.assign(process.env,saved);rmSync(folder,{recursive:true,force:true});}
+});
+test('OpenRouter environment credential never follows custom endpoint and unsafe OpenRouter paths fail closed',async()=>{
