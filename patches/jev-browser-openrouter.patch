@@ -0,0 +1,25 @@
+/** Transport-only OpenRouter adaptation; the upstream decision envelope is unchanged. */
+import { lstatSync, readFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { join } from 'node:path';
+import type { Fetch } from '@typesafe-ai/sdk';
+export function openRouterKey(): string | undefined {
+  if (Object.hasOwn(process.env, 'OPENROUTER_API_KEY')) return process.env.OPENROUTER_API_KEY?.trim() || undefined;
+  try {
+    const path = join(homedir(), '.config/siftr/.env');
+    const stat = lstatSync(path);
+    if (!stat.isFile() || (stat.mode & 0o077) !== 0) return undefined;
+    const match = readFileSync(path, 'utf8').match(/^\s*(?:export\s+)?OPENROUTER_API_KEY\s*=\s*(.*?)\s*$/m);
+    let value = match?.[1];
+    if (value && ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'")))) value = value.slice(1, -1);
+    return value?.trim() || undefined;
+  } catch { return undefined; }
+}
+export function openRouterFetch(fetcher: Fetch = (input, init) => globalThis.fetch(input, init)): Fetch {
+  return (input, init) => {
+    const url = new URL(String(input));
+    if (url.origin !== 'https://openrouter.ai' || url.pathname !== '/api/alpha/v1/systemone') throw new Error('Unexpected OpenRouter decision route');
+    url.pathname = '/api/alpha/decisions';
+    return fetcher(url.href, { ...init, redirect: 'error' });
+  };
+}
